{
  "name": "@elmir-mamedov/feedback",
  "version": "0.2.0",
  "description": "A feedback dialog with screenshots for any web app, and a Cloudflare Worker that files what people send as issues in a private GitHub repo.",
  "license": "MIT",
  "author": "Elmir Mamedov",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elmir-mamedov/feedback.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./widget": {
      "types": "./dist/widget/index.d.ts",
      "default": "./dist/widget/index.js"
    },
    "./relay": {
      "types": "./dist/relay/index.d.ts",
      "default": "./dist/relay/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.6",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
